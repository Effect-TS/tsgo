{
  "jsPlugins": ["@effect/tsgo/experimental/oxlint"],
  "categories": {
    "correctness": "off"
  },
  "settings": {
    "effect-tsgo": {
      "diagnosticSeverity": {
        "floatingEffect": "off"
      }
    }
  },
  "rules": {
    "effect/floatingEffect": "error",
    "effect/missingStarInYieldEffectGen": "warn"
  }
}
