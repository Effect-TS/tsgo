+package vfsmatch
+
+import (
+	"slices"
+	"testing"
+)
+
+func TestIncludeFileInRootDirectory(t *testing.T) {
+	for _, root := range []string{"/", "C:/"} {
+		t.Run(root, func(t *testing.T) {
+			got := getBasePaths(root, []string{"index.ts"}, true)
+			if !slices.Equal(got, []string{root}) {
+				t.Fatalf("got %v, want [%s]", got, root)
+			}
+		})
+	}
+}
