+// ValidateEffectPluginOptionsCallback is invoked after compilerOptions.plugins is
+// parsed from a tsconfig file, allowing external integrations to report
+// configuration diagnostics anchored on nodes inside that config file.
+var ValidateEffectPluginOptionsCallback func(sourceFile *ast.SourceFile, pluginsNode *ast.Node, options *core.CompilerOptions) []*ast.Diagnostic
+
+// RegisterValidateEffectPluginOptionsCallback registers a callback invoked after
+// compilerOptions.plugins is parsed from a tsconfig file.
+func RegisterValidateEffectPluginOptionsCallback(cb func(sourceFile *ast.SourceFile, pluginsNode *ast.Node, options *core.CompilerOptions) []*ast.Diagnostic) {
+	ValidateEffectPluginOptionsCallback = cb
+}
