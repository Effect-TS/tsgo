+// getTaggedTemplateStringsType refines only the synthetic argument; emitted JavaScript is unchanged.
+func (c *Checker) getTaggedTemplateStringsType(template *ast.Node) *Type {
+	base := c.getGlobalTemplateStringsArrayType()
+	if c.compilerOptions.Effect == nil || !c.compilerOptions.Effect.ExperimentalLiteralTemplateStrings {
+		return base
+	}
+	literals := []*ast.Node{template}
+	if ast.IsTemplateExpression(template) {
+		expression := template.AsTemplateExpression()
+		literals = make([]*ast.Node, len(expression.TemplateSpans.Nodes)+1)
+		literals[0] = expression.Head
+		for i, span := range expression.TemplateSpans.Nodes {
+			literals[i+1] = span.AsTemplateSpan().Literal
+		}
+	}
+	types := make([]*Type, len(literals))
+	infos := make([]TupleElementInfo, len(literals))
+	for i, literal := range literals {
+		// Invalid escapes produce undefined cooked values, not string literals.
+		if literal.TemplateLiteralLikeData().TemplateFlags&ast.TokenFlagsContainsInvalidEscape != 0 {
+			return base
+		}
+		types[i] = c.getStringLiteralType(literal.Text())
+		infos[i] = TupleElementInfo{flags: ElementFlagsRequired}
+	}
+	return c.getIntersectionType([]*Type{base, c.createTupleTypeEx(types, infos, true /*readonly*/)})
+}
