 	"slices"
 
 	"github.com/microsoft/TypeScript/tsc/internal/collections"
@@ -374,6 +375,9 @@ func CompilerOptionsAffectSemanticDiagnostics(oldOptions *core.CompilerOptions,
 	if oldOptions == nil || newOptions == nil {
 		return true
 	}
+	if !reflect.DeepEqual(oldOptions.Effect, newOptions.Effect) {
+		return true
+	}
 	if oldOptions.AllowArbitraryExtensions != newOptions.AllowArbitraryExtensions {
 		return true
 	}
