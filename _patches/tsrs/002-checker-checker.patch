 use crate::*;
 use tsrs_core::PSliceCell;
 
+// effect-tsgo patch 002 (checker.go `AfterCheckSourceFileCallback`).
+// AfterCheckSourceFileCallback is invoked after type checking each source file.
+// It allows external packages to run additional diagnostics with full type information.
+// Use Checker.AddDiagnostic to add diagnostics from within the callback.
+pub type AfterCheckSourceFileCallback = std::sync::Arc<
+    dyn Fn(&tsrs_core::context::Context, &'static dyn Program, &mut Checker, P<ast::SourceFile>)
+        + Send
+        + Sync,
+>;
+
+static AFTER_CHECK_SOURCE_FILE_CALLBACK: std::sync::RwLock<Option<AfterCheckSourceFileCallback>> =
+    std::sync::RwLock::new(None);
+
+// effect-tsgo patch 002 (checker.go `RegisterAfterCheckSourceFileCallback`).
+// RegisterAfterCheckSourceFileCallback registers a callback to be called after
+// each source file is type checked. The callback receives the program, checker
+// with full type information, and the source file that was checked.
+// Note: Only one callback can be registered. Subsequent calls will replace the previous callback.
+pub fn register_after_check_source_file_callback(cb: AfterCheckSourceFileCallback) {
+    *AFTER_CHECK_SOURCE_FILE_CALLBACK.write().unwrap_or_else(std::sync::PoisonError::into_inner) =
+        Some(cb);
+}
+
+/// tsrs-only (effect-tsgo patch 002): Go reads the package variable `AfterCheckSourceFileCallback`; the Rust port
+/// clones it out of its lock so the callback runs without holding the lock.
+pub(crate) fn after_check_source_file_callback() -> Option<AfterCheckSourceFileCallback> {
+    AFTER_CHECK_SOURCE_FILE_CALLBACK
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .clone()
+}
