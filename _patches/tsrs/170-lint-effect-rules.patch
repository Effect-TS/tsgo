tsrs-only: tsrs-lint (crates/tsrs_lint, the Rust port of tsgolint's headless linter, oxc-project/tsrs#624) is the
counterpart of the tsgolint binary that `_patches/tsgolint/001-effect-rules.patch` extends with the Effect rules.

Go appends the generated `effectRules` to tsgolint's `allRules`. tsrs-lint's registry is a closed `match`, so this adds
`registry::register_external_rules`: a factory consulted by `require_implemented` and `create_rule` for names the
registry does not know. As patch 001 does for tsrs_cli, the `effect-main` feature adds main.rs to the library as a
module whose `main` becomes public (`tsrs_lint::main`), so that crates/ets_tsrs_lint registers the Effect rules and
then calls it. The feature is off for the `tsrs-lint` binary target, which is unchanged.

diff --git a/crates/tsrs_lint/Cargo.toml b/crates/tsrs_lint/Cargo.toml
index 56e70f4..b6f005c 100644
--- a/crates/tsrs_lint/Cargo.toml
+++ b/crates/tsrs_lint/Cargo.toml
@@ -23,6 +23,11 @@ regex = "1"
 regress = "0.11.1"
 mimalloc-safe.workspace = true
 
+[features]
+# effect-tsgo: the executable's `main` as a library function (`tsrs_lint::main`), for crates/ets_tsrs_lint. Off for the
+# `tsrs-lint` binary target, which keeps main.rs (and its global allocator) to itself.
+effect-main = []
+
 [[bin]]
 name = "tsrs-lint"
 path = "src/main.rs"
diff --git a/crates/tsrs_lint/src/lib.rs b/crates/tsrs_lint/src/lib.rs
index b629fab..2f5bb23 100644
--- a/crates/tsrs_lint/src/lib.rs
+++ b/crates/tsrs_lint/src/lib.rs
@@ -17,6 +17,17 @@ pub mod utils;
 
 mod type_matches_specifier;
 
+// effect-tsgo: main.rs as a module (`tsrs_lint::main`), for crates/ets_tsrs_lint, which registers the Effect rules
+// first (as effect-tsgo's patched tsgolint appends them to `allRules`). main.rs reaches the modules above as
+// `tsrs_lint`.
+#[cfg(feature = "effect-main")]
+extern crate self as tsrs_lint;
+#[cfg(feature = "effect-main")]
+#[path = "main.rs"]
+mod effect_main;
+#[cfg(feature = "effect-main")]
+pub use effect_main::main;
+
 mod rules {
     pub mod await_thenable;
     pub mod consistent_return;
