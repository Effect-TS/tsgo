--- a/crates/tsrs_lint/src/main.rs
+++ b/crates/tsrs_lint/src/main.rs
@@ -11,7 +11,8 @@ use tsrs_lint::{engine, payload, protocol};
 #[global_allocator]
 static GLOBAL: mimalloc_safe::MiMalloc = mimalloc_safe::MiMalloc;
 
-fn main() {
