diff --git a/crates/tsrs_incremental/src/buildinfoeffect.rs b/crates/tsrs_incremental/src/buildinfoeffect.rs
new file mode 100644
index 0000000..0df0127
--- /dev/null
+++ b/crates/tsrs_incremental/src/buildinfoeffect.rs
@@ -0,0 +1,304 @@
+// effect-tsgo patch 028: the `effect` member of the build info, Go's encoding/json of `*etscore.EffectPluginOptions`
+// through its `json:` struct tags. Every field is `omitzero` but KeyPattern's: a false, zero or empty-string value and
+// a nil slice, map or pointer are omitted, while an empty non-nil slice or map is written as `[]` / `{}`. Members are
+// in Go's field order; Go writes map entries in random order, and they are sorted here.
+
+use std::borrow::Cow;
+
+use ets_etscore::{
+    EffectPluginOptions, KeyPattern, Override, OverrideOptions, Severity,
+    TopLevelNamedReexportsMode, parse_severity,
+};
+use rustc_hash::FxHashMap;
+use tsrs_core::collections::OrderedMap;
+use tsrs_core::json::Value;
+
+type Object = OrderedMap<String, Value>;
+
+pub(crate) fn marshal_effect_options(options: &EffectPluginOptions) -> Value {
+    let mut o = Members::default();
+    o.bool("refactors", options.refactors);
+    o.bool("diagnostics", options.diagnostics);
+    o.bool("includeSuggestionsInTsc", options.include_suggestions_in_tsc);
+    o.bool("quickinfo", options.quickinfo);
+    o.bool("completions", options.completions);
+    o.bool("goto", options.goto);
+    o.bool("renames", options.renames);
+    o.bool(
+        "ignoreEffectSuggestionsInTscExitCode",
+        options.ignore_effect_suggestions_in_tsc_exit_code,
+    );
+    o.bool("ignoreEffectWarningsInTscExitCode", options.ignore_effect_warnings_in_tsc_exit_code);
+    o.bool("ignoreEffectErrorsInTscExitCode", options.ignore_effect_errors_in_tsc_exit_code);
+    o.bool("skipDisabledOptimization", options.skip_disabled_optimization);
+    o.str("mermaidProvider", &options.mermaid_provider);
+    o.bool("noExternal", options.no_external);
+    o.int("layerGraphFollowDepth", options.layer_graph_follow_depth);
+    o.bool("inlays", options.inlays);
+    o.opt("namespaceImportPackages", options.namespace_import_packages.as_deref(), strings);
+    o.opt("barrelImportPackages", options.barrel_import_packages.as_deref(), strings);
+    o.opt("importAliases", options.import_aliases.as_ref(), string_map);
+    o.str("topLevelNamedReexports", &options.top_level_named_reexports.0);
+    o.opt("keyPatterns", options.key_patterns.as_deref(), key_patterns);
+    o.bool("extendedKeyDetection", options.extended_key_detection);
+    o.int("pipeableMinArgCount", options.pipeable_min_arg_count);
+    o.opt("allowedUnstableApis", options.allowed_unstable_apis.as_deref(), strings);
+    o.opt("allowedExperimentalApis", options.allowed_experimental_apis.as_deref(), strings);
+    o.opt("allowedDuplicatedPackages", options.allowed_duplicated_packages.as_deref(), strings);
+    o.opt("effectFn", options.effect_fn.as_deref(), strings);
+    o.opt("diagnosticSeverity", options.diagnostic_severity.as_ref(), severity_map);
+    o.opt("overrides", options.overrides.as_deref(), |overrides| {
+        Value::Array(overrides.iter().map(marshal_override).collect())
+    });
+    Value::Object(o.0)
+}
+
+pub(crate) fn unmarshal_effect_options(data: &Value) -> Result<EffectPluginOptions, String> {
+    let o = object(data, "effect")?;
+    Ok(EffectPluginOptions {
+        refactors: get_bool(o, "refactors")?,
+        diagnostics: get_bool(o, "diagnostics")?,
+        include_suggestions_in_tsc: get_bool(o, "includeSuggestionsInTsc")?,
+        quickinfo: get_bool(o, "quickinfo")?,
+        completions: get_bool(o, "completions")?,
+        goto: get_bool(o, "goto")?,
+        renames: get_bool(o, "renames")?,
+        ignore_effect_suggestions_in_tsc_exit_code: get_bool(
+            o,
+            "ignoreEffectSuggestionsInTscExitCode",
+        )?,
+        ignore_effect_warnings_in_tsc_exit_code: get_bool(o, "ignoreEffectWarningsInTscExitCode")?,
+        ignore_effect_errors_in_tsc_exit_code: get_bool(o, "ignoreEffectErrorsInTscExitCode")?,
+        skip_disabled_optimization: get_bool(o, "skipDisabledOptimization")?,
+        mermaid_provider: get_opt(o, "mermaidProvider", as_string)?.unwrap_or_default(),
+        no_external: get_bool(o, "noExternal")?,
+        layer_graph_follow_depth: get_opt(o, "layerGraphFollowDepth", as_int)?.unwrap_or_default(),
+        inlays: get_bool(o, "inlays")?,
+        namespace_import_packages: get_opt(o, "namespaceImportPackages", as_strings)?,
+        barrel_import_packages: get_opt(o, "barrelImportPackages", as_strings)?,
+        import_aliases: get_opt(o, "importAliases", as_string_map)?,
+        top_level_named_reexports: get_opt(o, "topLevelNamedReexports", as_mode)?
+            .unwrap_or_default(),
+        key_patterns: get_opt(o, "keyPatterns", as_key_patterns)?,
+        extended_key_detection: get_bool(o, "extendedKeyDetection")?,
+        pipeable_min_arg_count: get_opt(o, "pipeableMinArgCount", as_int)?.unwrap_or_default(),
+        allowed_unstable_apis: get_opt(o, "allowedUnstableApis", as_strings)?,
+        allowed_experimental_apis: get_opt(o, "allowedExperimentalApis", as_strings)?,
+        allowed_duplicated_packages: get_opt(o, "allowedDuplicatedPackages", as_strings)?,
+        effect_fn: get_opt(o, "effectFn", as_strings)?,
+        diagnostic_severity: get_opt(o, "diagnosticSeverity", as_severity_map)?,
+        overrides: get_opt(o, "overrides", |v| {
+            array(v, "overrides")?.iter().map(unmarshal_override).collect()
+        })?,
+    })
+}
+
+fn marshal_override(o: &Override) -> Value {
+    let mut m = Members::default();
+    m.opt("include", o.include.as_deref(), strings);
+    m.opt("exclude", o.exclude.as_deref(), strings);
+    if o.options != OverrideOptions::default() {
+        m.set("options", marshal_override_options(&o.options));
+    }
+    Value::Object(m.0)
+}
+
+fn unmarshal_override(data: &Value) -> Result<Override, String> {
+    let o = object(data, "overrides")?;
+    Ok(Override {
+        include: get_opt(o, "include", as_strings)?,
+        exclude: get_opt(o, "exclude", as_strings)?,
+        options: get_opt(o, "options", unmarshal_override_options)?.unwrap_or_default(),
+    })
+}
+
+fn marshal_override_options(o: &OverrideOptions) -> Value {
+    let mut m = Members::default();
+    m.opt("diagnosticSeverity", o.diagnostic_severity.as_ref(), severity_map);
+    m.opt("pipeableMinArgCount", o.pipeable_min_arg_count.as_ref(), |&n| Value::Integer(n));
+    m.opt("keyPatterns", o.key_patterns.as_deref(), key_patterns);
+    m.opt("extendedKeyDetection", o.extended_key_detection.as_ref(), |&b| Value::Bool(b));
+    m.opt("allowedUnstableApis", o.allowed_unstable_apis.as_deref(), strings);
+    m.opt("allowedExperimentalApis", o.allowed_experimental_apis.as_deref(), strings);
+    m.opt("allowedDuplicatedPackages", o.allowed_duplicated_packages.as_deref(), strings);
+    m.opt("effectFn", o.effect_fn.as_deref(), strings);
+    m.opt("namespaceImportPackages", o.namespace_import_packages.as_deref(), strings);
+    m.opt("barrelImportPackages", o.barrel_import_packages.as_deref(), strings);
+    m.opt("importAliases", o.import_aliases.as_ref(), string_map);
+    m.opt("topLevelNamedReexports", o.top_level_named_reexports.as_ref(), |mode| {
+        Value::String(mode.0.to_string())
+    });
+    Value::Object(m.0)
+}
+
+fn unmarshal_override_options(data: &Value) -> Result<OverrideOptions, String> {
+    let o = object(data, "options")?;
+    Ok(OverrideOptions {
+        diagnostic_severity: get_opt(o, "diagnosticSeverity", as_severity_map)?,
+        pipeable_min_arg_count: get_opt(o, "pipeableMinArgCount", as_int)?,
+        key_patterns: get_opt(o, "keyPatterns", as_key_patterns)?,
+        extended_key_detection: get_opt(o, "extendedKeyDetection", as_bool)?,
+        allowed_unstable_apis: get_opt(o, "allowedUnstableApis", as_strings)?,
+        allowed_experimental_apis: get_opt(o, "allowedExperimentalApis", as_strings)?,
+        allowed_duplicated_packages: get_opt(o, "allowedDuplicatedPackages", as_strings)?,
+        effect_fn: get_opt(o, "effectFn", as_strings)?,
+        namespace_import_packages: get_opt(o, "namespaceImportPackages", as_strings)?,
+        barrel_import_packages: get_opt(o, "barrelImportPackages", as_strings)?,
+        import_aliases: get_opt(o, "importAliases", as_string_map)?,
+        top_level_named_reexports: get_opt(o, "topLevelNamedReexports", as_mode)?,
+    })
+}
+
+// KeyPattern's tags have no `omitzero`: every member is written, a nil slice as `[]` (json/v2).
+fn key_patterns(patterns: &[KeyPattern]) -> Value {
+    Value::Array(
+        patterns
+            .iter()
+            .map(|p| {
+                let mut m = Members::default();
+                m.set("target", Value::String(p.target.clone()));
+                m.set("pattern", Value::String(p.pattern.clone()));
+                m.set(
+                    "skipLeadingPath",
+                    strings(p.skip_leading_path.as_deref().unwrap_or_default()),
+                );
+                Value::Object(m.0)
+            })
+            .collect(),
+    )
+}
+
+fn as_key_patterns(data: &Value) -> Result<Vec<KeyPattern>, String> {
+    array(data, "keyPatterns")?
+        .iter()
+        .map(|v| {
+            let o = object(v, "keyPatterns")?;
+            Ok(KeyPattern {
+                target: get_opt(o, "target", as_string)?.unwrap_or_default(),
+                pattern: get_opt(o, "pattern", as_string)?.unwrap_or_default(),
+                skip_leading_path: get_opt(o, "skipLeadingPath", as_strings)?,
+            })
+        })
+        .collect()
+}
+
+#[derive(Default)]
+struct Members(Object);
+
+impl Members {
+    fn set(&mut self, key: &str, v: Value) {
+        self.0.insert(key.to_string(), v);
+    }
+    fn bool(&mut self, key: &str, v: bool) {
+        if v {
+            self.set(key, Value::Bool(true));
+        }
+    }
+    fn int(&mut self, key: &str, v: i64) {
+        if v != 0 {
+            self.set(key, Value::Integer(v));
+        }
+    }
+    fn str(&mut self, key: &str, v: &str) {
+        if !v.is_empty() {
+            self.set(key, Value::String(v.to_string()));
+        }
+    }
+    fn opt<T: ?Sized>(&mut self, key: &str, v: Option<&T>, f: impl FnOnce(&T) -> Value) {
+        if let Some(v) = v {
+            self.set(key, f(v));
+        }
+    }
+}
+
+fn strings(v: &[String]) -> Value {
+    Value::Array(v.iter().map(|s| Value::String(s.clone())).collect())
+}
+
+fn sorted_map<T>(map: &FxHashMap<String, T>, f: impl Fn(&T) -> Value) -> Value {
+    let mut keys: Vec<&String> = map.keys().collect();
+    keys.sort();
+    let mut o = Object::default();
+    for key in keys {
+        o.insert(key.clone(), f(&map[key]));
+    }
+    Value::Object(o)
+}
+
+fn string_map(map: &FxHashMap<String, String>) -> Value {
+    sorted_map(map, |s| Value::String(s.clone()))
+}
+
+// Severity.MarshalJSON
+fn severity_map(map: &FxHashMap<String, Severity>) -> Value {
+    sorted_map(map, |s| Value::String(s.string().to_string()))
+}
+
+fn object<'a>(v: &'a Value, key: &str) -> Result<&'a Object, String> {
+    match v {
+        Value::Object(o) => Ok(o),
+        _ => Err(format!("invalid {key}")),
+    }
+}
+
+fn array<'a>(v: &'a Value, key: &str) -> Result<&'a [Value], String> {
+    match v {
+        Value::Array(items) => Ok(items),
+        _ => Err(format!("invalid {key}")),
+    }
+}
+
+// A missing member keeps the zero value, as does `null` (Go unmarshals `null` into a slice, map or pointer as nil).
+fn get_opt<T>(
+    o: &Object,
+    key: &str,
+    f: impl Fn(&Value) -> Result<T, String>,
+) -> Result<Option<T>, String> {
+    match o.get(key) {
+        None | Some(Value::Null) => Ok(None),
+        Some(v) => f(v).map(Some).map_err(|_| format!("invalid {key}")),
+    }
+}
+
+fn get_bool(o: &Object, key: &str) -> Result<bool, String> {
+    Ok(get_opt(o, key, as_bool)?.unwrap_or_default())
+}
+
+fn as_bool(v: &Value) -> Result<bool, String> {
+    match v {
+        Value::Bool(b) => Ok(*b),
+        _ => Err(String::new()),
+    }
+}
+
+fn as_int(v: &Value) -> Result<i64, String> {
+    match v {
+        Value::Number(n) if n.fract() == 0.0 => Ok(*n as i64),
+        Value::Integer(n) => Ok(*n),
+        _ => Err(String::new()),
+    }
+}
+
+fn as_string(v: &Value) -> Result<String, String> {
+    match v {
+        Value::String(s) => Ok(s.clone()),
+        _ => Err(String::new()),
+    }
+}
+
+fn as_strings(v: &Value) -> Result<Vec<String>, String> {
+    array(v, "")?.iter().map(as_string).collect()
+}
+
+fn as_mode(v: &Value) -> Result<TopLevelNamedReexportsMode, String> {
+    Ok(TopLevelNamedReexportsMode(Cow::Owned(as_string(v)?)))
+}
+
+fn as_string_map(v: &Value) -> Result<FxHashMap<String, String>, String> {
+    object(v, "")?.iter().map(|(k, v)| Ok((k.clone(), as_string(v)?))).collect()
+}
+
+// Severity.UnmarshalJSON
+fn as_severity_map(v: &Value) -> Result<FxHashMap<String, Severity>, String> {
+    object(v, "")?.iter().map(|(k, v)| Ok((k.clone(), parse_severity(&as_string(v)?)))).collect()
+}
diff --git a/crates/tsrs_incremental/src/buildinfoeffect_test.rs b/crates/tsrs_incremental/src/buildinfoeffect_test.rs
new file mode 100644
index 0000000..8125d8d
--- /dev/null
+++ b/crates/tsrs_incremental/src/buildinfoeffect_test.rs
@@ -0,0 +1,83 @@
+// effect-tsgo patch 028: the `effect` build info member against Go's bytes. The expectations are the `effect` member
+// of .tsbuildinfo files written by the Go build (Go writes map entries in random order; these are sorted).
+use std::borrow::Cow;
+
+use ets_etscore::{
+    EffectPluginOptions, KeyPattern, Override, OverrideOptions, Severity,
+    TopLevelNamedReexportsMode,
+};
+
+use crate::buildinfoeffect::{marshal_effect_options, unmarshal_effect_options};
+
+fn round_trip(go: &str) -> String {
+    let options = unmarshal_effect_options(&tsrs_core::json::unmarshal(go).unwrap()).unwrap();
+    tsrs_core::json::marshal(&marshal_effect_options(&options)).unwrap()
+}
+
+#[test]
+fn test_effect_options_match_go_encoding() {
+    let options = EffectPluginOptions {
+        refactors: true,
+        diagnostics: true,
+        layer_graph_follow_depth: 2,
+        namespace_import_packages: Some(vec![]),
+        import_aliases: Some(
+            [
+                ("effect".to_string(), "E".to_string()),
+                ("@effect/platform".to_string(), "P".to_string()),
+            ]
+            .into_iter()
+            .collect(),
+        ),
+        key_patterns: Some(vec![KeyPattern {
+            target: "service".into(),
+            pattern: "default".into(),
+            skip_leading_path: None,
+        }]),
+        diagnostic_severity: Some(
+            [
+                ("floatingEffect".to_string(), Severity::Warning),
+                ("leakingRequirements".to_string(), Severity::Off),
+            ]
+            .into_iter()
+            .collect(),
+        ),
+        overrides: Some(vec![
+            Override {
+                include: Some(vec!["src/**".into()]),
+                exclude: None,
+                options: OverrideOptions {
+                    pipeable_min_arg_count: Some(3),
+                    extended_key_detection: Some(false),
+                    effect_fn: Some(vec![]),
+                    top_level_named_reexports: Some(TopLevelNamedReexportsMode(Cow::Borrowed(
+                        "follow",
+                    ))),
+                    ..Default::default()
+                },
+            },
+            Override { include: None, exclude: Some(vec![]), options: OverrideOptions::default() },
+        ]),
+        ..Default::default()
+    };
+    let go = r#"{"refactors":true,"diagnostics":true,"layerGraphFollowDepth":2,"namespaceImportPackages":[],"importAliases":{"@effect/platform":"P","effect":"E"},"keyPatterns":[{"target":"service","pattern":"default","skipLeadingPath":[]}],"diagnosticSeverity":{"floatingEffect":"warning","leakingRequirements":"off"},"overrides":[{"include":["src/**"],"options":{"pipeableMinArgCount":3,"extendedKeyDetection":false,"effectFn":[],"topLevelNamedReexports":"follow"}},{"exclude":[]}]}"#;
+    assert_eq!(tsrs_core::json::marshal(&marshal_effect_options(&options)).unwrap(), go);
+    let mut decoded = options;
+    decoded.key_patterns.as_mut().unwrap()[0].skip_leading_path = Some(vec![]);
+    assert_eq!(
+        unmarshal_effect_options(&tsrs_core::json::unmarshal(go).unwrap()).unwrap(),
+        decoded
+    );
+}
+
+#[test]
+fn test_effect_options_round_trip_go_build_info() {
+    for go in [
