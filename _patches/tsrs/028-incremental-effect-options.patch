diff --git a/crates/tsrs_tsoptions/src/effect_options_test.rs b/crates/tsrs_tsoptions/src/effect_options_test.rs
new file mode 100644
index 0000000..056258a
--- /dev/null
+++ b/crates/tsrs_tsoptions/src/effect_options_test.rs
@@ -0,0 +1,37 @@
+// effect-tsgo patch 028 (tsoptions/effect_options_test.go).
+use std::sync::Arc;
+
+use tsrs_core::CompilerOptions;
+
+use crate::compiler_options_affect_semantic_diagnostics;
+
+#[test]
+fn test_effect_options_invalidate_semantic_diagnostics() {
+    let effect = |diagnostics| CompilerOptions {
+        effect: Some(Arc::new(ets_etscore::EffectPluginOptions {
+            diagnostics,
+            ..Default::default()
+        }))
+        .into(),
+        ..Default::default()
+    };
+    let old_options = effect(true);
+    let new_options = effect(true);
+    assert!(
+        !compiler_options_affect_semantic_diagnostics(Some(&old_options), Some(&new_options)),
+        "equal Effect options must retain semantic diagnostics"
+    );
+    let new_options = effect(false);
+    assert!(
+        compiler_options_affect_semantic_diagnostics(Some(&old_options), Some(&new_options)),
+        "changed Effect options must invalidate semantic diagnostics"
+    );
+    assert!(
+        !compiler_options_affect_semantic_diagnostics(None, None),
+        "nil options must compare safely"
+    );
+    assert!(
+        compiler_options_affect_semantic_diagnostics(Some(&old_options), None),
+        "removing options must invalidate semantic diagnostics"
+    );
+}
