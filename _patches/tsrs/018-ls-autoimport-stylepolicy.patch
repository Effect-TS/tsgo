+// effect-tsgo patch 018 (fix.go `FixTransformer`).
+// FixTransformer is a function that transforms auto-import fixes based on
+// style preferences. It receives an export and a list of fixes, and returns
+// the (potentially rewritten) list of fixes. A nil return suppresses the fixes.
+//
+// tsrs-only: Go's `[]*Fix` is `Vec<Arc<Fix>>` (an empty one is Go's nil); Go's `*Export` may be nil.
+pub type FixTransformer =
+    Box<dyn Fn(Option<&Export>, Vec<Arc<Fix>>) -> Vec<Arc<Fix>> + Send + Sync>;
+
+/// tsrs-only (effect-tsgo patch 018): the type of Go's `autoImportFixTransformerFactory` (a `func` type there).
+pub type AutoImportFixTransformerFactory = Arc<
+    dyn Fn(
+            &modulespecifiers::UserPreferences,
+            &'static Program,
+            P<SourceFile>,
+        ) -> Option<FixTransformer>
+        + Send
+        + Sync,
+>;
+
+// effect-tsgo patch 018 (fix.go `autoImportFixTransformerFactory`).
+// autoImportFixTransformerFactory is the registered factory that creates a
+// FixTransformer from user preferences and the compiler program.
+// Set via RegisterAutoImportFixTransformer.
+static AUTO_IMPORT_FIX_TRANSFORMER_FACTORY: std::sync::RwLock<
+    Option<AutoImportFixTransformerFactory>,
+> = std::sync::RwLock::new(None);
+
+// effect-tsgo patch 018 (fix.go `RegisterAutoImportFixTransformer`).
+// RegisterAutoImportFixTransformer registers a factory function that will be
+// called during NewView to create a FixTransformer from user preferences and
+// the compiler program. Only one factory can be registered; subsequent calls
+// replace the previous one.
+pub fn register_auto_import_fix_transformer(factory: AutoImportFixTransformerFactory) {
+    *AUTO_IMPORT_FIX_TRANSFORMER_FACTORY
+        .write()
+        .unwrap_or_else(std::sync::PoisonError::into_inner) = Some(factory);
+}
+
+/// tsrs-only (effect-tsgo patch 018): Go reads the package variable `autoImportFixTransformerFactory` (in
+/// `NewView`, patch 027); the Rust port clones it out of its lock so the factory runs without holding the lock.
+pub(crate) fn auto_import_fix_transformer_factory() -> Option<AutoImportFixTransformerFactory> {
+    AUTO_IMPORT_FIX_TRANSFORMER_FACTORY
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .clone()
+}
+
+impl View {
+    // effect-tsgo patch 018 (fix.go `View.applyStylePolicy`).
+    fn apply_style_policy(&self, export: &Export, fixes: Vec<Arc<Fix>>) -> Vec<Arc<Fix>> {
+        let Some(fix_transformer) = &self.fix_transformer else {
+            return fixes;
+        };
+        if fixes.is_empty() {
+            return fixes;
+        }
+        fix_transformer(Some(export), fixes)
     }
 }
 
