+// externalRefactorProviders holds providers registered by external packages (e.g., etslshooks).
+static EXTERNAL_REFACTOR_PROVIDERS: std::sync::RwLock<Vec<&'static RefactorProvider>> =
+    std::sync::RwLock::new(Vec::new());
