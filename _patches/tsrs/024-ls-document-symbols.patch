+// AfterDocumentSymbolsCallback is invoked after document symbols are collected
+// and expando merging is complete, allowing external packages to augment the
+// hierarchical symbol tree before it is returned or flattened.
+pub type AfterDocumentSymbolsCallback = fn(
+    ctx: &Context,
+    sf: P<SourceFile>,
+    symbols: Vec<DocSym>,
+    program: &'static Program,
+    lang_service: &LanguageService,
+) -> Vec<DocSym>;
+
+static AFTER_DOCUMENT_SYMBOLS_CALLBACK: std::sync::RwLock<Option<AfterDocumentSymbolsCallback>> =
+    std::sync::RwLock::new(None);
+
+// RegisterAfterDocumentSymbolsCallback registers a callback that can augment
+// document symbols after upstream collection and expando merging.
+// Note: Only one callback can be registered. Subsequent calls replace it.
+pub fn register_after_document_symbols_callback(cb: AfterDocumentSymbolsCallback) {
+    *AFTER_DOCUMENT_SYMBOLS_CALLBACK.write().unwrap() = Some(cb);
+}
