+// tsrs-only: the server as the session's `project::Client` and `ata.NpmExecutor`. Go's session holds the
+// `*Server` itself and the GC collects the cycle; here the server owns the session, so the session refers to the
+// server weakly and dropping the last `Arc<Server>` frees the session with its snapshots and programs (an in-process
+// server per test, `lsptestutil`). Once the server is gone, its methods do nothing.
+struct sessionClient(Weak<Server>);
+
+impl sessionClient {
+    fn with<R>(&self, gone: R, f: impl FnOnce(&Server) -> R) -> R {
+        self.0.upgrade().map_or(gone, |s| f(&s))
+    }
+}
