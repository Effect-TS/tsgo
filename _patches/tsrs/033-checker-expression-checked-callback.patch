@@ -9,6 +9,23 @@
 //   type UnusedKind (checker.go:7249)
 //   const (checker.go:7251): UnusedKindLocal, UnusedKindParameter
 
+// effect-tsgo patch 033 (checker.go `ExpressionCheckedCallback`).
+// ExpressionCheckedCallback is invoked with the result of every checkExpressionEx
+// evaluation, including intermediate inference passes; checkMode tells them apart.
+pub type ExpressionCheckedCallback = fn(&mut Checker, P<Node>, CheckMode, P<Type>);
+
+static EXPRESSION_CHECKED_CALLBACK: std::sync::OnceLock<ExpressionCheckedCallback> =
+    std::sync::OnceLock::new();
+
+// effect-tsgo patch 033 (checker.go `RegisterExpressionCheckedCallback`).
+// RegisterExpressionCheckedCallback registers the callback invoked after each
+// expression is checked. Only one callback can be registered.
+// tsrs-only: the first registration wins (a lock-free read on the hot path); Go's later registrations replace it,
+// and every Go registrant registers the same function.
+pub fn register_expression_checked_callback(cb: ExpressionCheckedCallback) {
+    let _ = EXPRESSION_CHECKED_CALLBACK.set(cb);
+}
+
 impl Checker {
     // checker.go:6527
     pub(crate) fn get_iteration_types_of_iterable_fast(
@@ -2059,6 +2076,9 @@
         }
         self.current_node = save_current_node;
         self.end_instantiation_count();
+        if let Some(cb) = EXPRESSION_CHECKED_CALLBACK.get() {
+            cb(self, node, check_mode, t);
+        }
         t
     }
 
