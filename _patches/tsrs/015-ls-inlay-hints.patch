+// AfterInlayHintsCallback is invoked after inlay hints are computed
+// to allow external packages to filter or modify inlay hints.
+pub type AfterInlayHintsCallback = fn(
+    program: &'static tsrs_compiler::Program,
+    c: &mut Checker,
+    sf: P<SourceFile>,
+    span: TextRange,
+    preferences: &InlayHintsPreferences,
+    hints: Vec<lsproto::InlayHint>,
+    converters: &Converters,
+) -> Vec<lsproto::InlayHint>;
+
+static AFTER_INLAY_HINTS_CALLBACK: std::sync::RwLock<Option<AfterInlayHintsCallback>> =
+    std::sync::RwLock::new(None);
+
+// RegisterAfterInlayHintsCallback registers a callback to be called after
+// inlay hints are computed. The callback can filter or modify the hints
+// before they are returned.
+// Note: Only one callback can be registered. Subsequent calls will replace the previous callback.
+pub fn register_after_inlay_hints_callback(cb: AfterInlayHintsCallback) {
+    *AFTER_INLAY_HINTS_CALLBACK.write().unwrap() = Some(cb);
+}
