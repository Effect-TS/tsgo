+// effect-tsgo patch 013 (parsinghelpers.go `MergeCompilerOptionsCallback`).
+// MergeCompilerOptionsCallback is invoked after the standard compiler option
+// merge, allowing external integrations to customize merging for custom fields.
+//
+// tsrs-only: Go's `targetOptions`/`sourceOptions` are never nil when it is called; the arguments after them are
+// `rawSource`, `sourceConfigPath` and `basePath`.
+pub type MergeCompilerOptionsCallback = std::sync::Arc<
+    dyn Fn(&mut CompilerOptions, &CompilerOptions, Option<&CompilerOptionsValue>, &str, &str)
+        + Send
+        + Sync,
+>;
+
+static MERGE_COMPILER_OPTIONS_CALLBACK: std::sync::RwLock<Option<MergeCompilerOptionsCallback>> =
+    std::sync::RwLock::new(None);
+
+// effect-tsgo patch 013 (parsinghelpers.go `RegisterMergeCompilerOptionsCallback`).
+pub fn register_merge_compiler_options_callback(cb: MergeCompilerOptionsCallback) {
+    *MERGE_COMPILER_OPTIONS_CALLBACK.write().unwrap_or_else(std::sync::PoisonError::into_inner) =
+        Some(cb);
+}
+
+/// tsrs-only (effect-tsgo patch 013): Go reads the package variable `MergeCompilerOptionsCallback`; the Rust port
+/// clones it out of its lock so the callback runs without holding the lock.
+fn merge_compiler_options_callback() -> Option<MergeCompilerOptionsCallback> {
+    MERGE_COMPILER_OPTIONS_CALLBACK
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .clone()
+}
+
+// effect-tsgo patch 013: etscore's `ParseFromPlugins` type-switches on Go's `any`, the tsconfig value that tsrs
+// holds as `CompilerOptionsValue`. `ets_etscore` cannot depend on tsrs, so the trait is implemented here.
+impl ets_etscore::AnyValue for CompilerOptionsValue {
+    fn is_nil(&self) -> bool {
+        matches!(self, CompilerOptionsValue::Null)
+    }
+
+    fn as_bool(&self) -> Option<bool> {
+        match self {
+            CompilerOptionsValue::Bool(b) => Some(*b),
+            _ => None,
+        }
+    }
+
+    fn as_float64(&self) -> Option<f64> {
+        match self {
+            CompilerOptionsValue::Float(f) => Some(*f),
+            _ => None,
+        }
+    }
+
+    fn as_string(&self) -> Option<&str> {
+        match self {
+            CompilerOptionsValue::String(s) => Some(s),
+            _ => None,
+        }
+    }
+
+    fn as_slice(&self) -> Option<&[Self]> {
+        match self {
+            CompilerOptionsValue::Array(a) => Some(a),
+            CompilerOptionsValue::NilArray => Some(&[]),
+            _ => None,
+        }
+    }
+
+    fn as_string_any_map(&self) -> Option<Vec<(&str, &Self)>> {
+        match self {
+            CompilerOptionsValue::Object(m) => {
+                Some(m.iter().map(|(k, v)| (k.as_str(), v)).collect())
+            }
+            _ => None,
+        }
+    }
+}
