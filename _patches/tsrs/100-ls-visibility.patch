@@ -281,7 +281,8 @@ impl Tracker {
     }
 
     // trackerimpl.go:295
-    fn get_nonformatted_text(
+    // effect-tsgo patch 100: public (Go shim accessor `change.Tracker_getNonformattedText`).
+    pub fn get_nonformatted_text(
         &self,
         node: P<Node>,
         source_file: P<SourceFile>,
