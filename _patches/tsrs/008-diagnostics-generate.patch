diff --git a/crates/tsrs_diagnostics/build.rs b/crates/tsrs_diagnostics/build.rs
new file mode 100644
index 0000000..05afbfb
--- /dev/null
+++ b/crates/tsrs_diagnostics/build.rs
@@ -0,0 +1,117 @@
+// effect-tsgo patch 008 (diagnostics/generate.go): Effect diagnostic messages.
+//
+// Go's generator reads effect-tsgo's `internal/diagnostics/effectDiagnosticMessages.json` next to
+// `diagnosticMessages.json` (when it exists) and emits its messages with the same naming. tsrs's `generated.rs` is
+// produced once from Go's output at tsrs's TypeScript pin, so the Effect messages are generated here instead, from
+// the same JSON, into `$OUT_DIR/effect_generated.rs`: statics named and keyed as Go's `convertPropertyName` does,
+// plus `EFFECT_MESSAGES`, sorted by code as Go sorts every message.
+
+use std::fmt::Write as _;
+use std::path::Path;
+
+fn main() {
+    let manifest_dir = std::env::var("CARGO_MANIFEST_DIR").unwrap();
+    // tsrs/crates/tsrs_diagnostics -> the effect-tsgo repository root (Go: "../../../../internal/...", relative to
+    // typescript/tsc/internal/diagnostics).
+    let path = Path::new(&manifest_dir)
+        .join("../../../internal/diagnostics/effectDiagnosticMessages.json");
+    println!("cargo:rerun-if-changed={}", path.display());
+
+    let mut messages: Vec<(String, i64, String, [bool; 3])> = Vec::new();
+    // Go: the file is read only when it exists.
+    if let Ok(text) = std::fs::read_to_string(&path) {
+        let raw: serde_json::Map<String, serde_json::Value> = serde_json::from_str(&text)
+            .unwrap_or_else(|err| panic!("failed to decode file: {err}"));
+        for (key, value) in raw {
+            let code = value["code"].as_i64().expect("code");
+            if let Some(existing) = messages.iter().find(|m| m.1 == code) {
+                panic!("diagnostics {:?} and {key:?} both use code {code}", existing.0);
+            }
+            let category = value["category"].as_str().expect("category").to_string();
+            let flag =
+                |name: &str| value.get(name).and_then(serde_json::Value::as_bool).unwrap_or(false);
+            let flags = [
+                flag("reportsUnnecessary"),
+                flag("elidedInCompatibilityPyramid"),
+                flag("reportsDeprecated"),
+            ];
+            messages.push((key, code, category, flags));
+        }
+    }
+    messages.sort_by_key(|m| m.1);
+
+    let mut out = String::from(
+        "// Code generated by build.rs from effectDiagnosticMessages.json; DO NOT EDIT.\n\n",
+    );
+    let mut names = Vec::new();
+    for (text, code, category, flags) in &messages {
+        let (var_name, key) = convert_property_name(text, *code);
+        writeln!(
+            out,
+            "pub static {var_name}: Message = Message {{ code: {code}, category: Category::{category}, key: \
+             Key({key:?}), text: {text:?}, reports_unnecessary: {}, elided_in_compatibility_pyramid: {}, \
+             reports_deprecated: {} }};\n",
+            flags[0], flags[1], flags[2]
+        )
+        .unwrap();
+        names.push(var_name);
+    }
+    out.push_str("pub(crate) static EFFECT_MESSAGES: &[&Message] = &[\n");
+    for name in &names {
+        writeln!(out, "    &{name},").unwrap();
+    }
+    out.push_str("];\n");
+
+    let out_dir = std::env::var("OUT_DIR").unwrap();
+    std::fs::write(Path::new(&out_dir).join("effect_generated.rs"), out).unwrap();
+}
+
+// Go's convertPropertyName (generate.go).
+fn convert_property_name(orig_name: &str, code: i64) -> (String, String) {
+    let mut b = String::with_capacity(orig_name.len());
+    for r in orig_name.chars() {
+        match r {
+            '*' => b.push_str("_Asterisk"),
+            '/' => b.push_str("_Slash"),
+            ':' => b.push_str("_Colon"),
+            // Go: unicode.IsLetter / unicode.IsDigit.
+            _ if !r.is_alphabetic() && !r.is_numeric() => b.push('_'),
+            _ => b.push(r),
+        }
+    }
+
+    // get rid of all multi-underscores
+    let mut var_name = String::with_capacity(b.len());
+    for r in b.chars() {
+        if r == '_' && var_name.ends_with('_') {
+            continue;
+        }
+        var_name.push(r);
+    }
+    // remove any leading underscore, unless it is followed by a number.
+    let trimmed = var_name.trim_start_matches('_');
+    if trimmed.len() != var_name.len()
+        && trimmed.chars().next().is_some_and(|c| !c.is_ascii_digit())
+    {
+        var_name = trimmed.to_string();
+    }
+    // get rid of all trailing underscores.
+    if var_name.ends_with('_') {
+        var_name.pop();
+    }
+
+    let mut key = var_name.clone();
+    if key.len() > 100 {
+        key.truncate(100);
+    }
+    key = format!("{key}_{code}");
+
+    if !var_name.chars().next().is_some_and(char::is_uppercase) {
+        var_name = if var_name.starts_with('_') {
+            format!("X{var_name}")
+        } else {
+            format!("X_{var_name}")
+        };
+    }
+    (var_name, key)
+}
