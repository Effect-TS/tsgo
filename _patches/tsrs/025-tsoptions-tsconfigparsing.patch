+// effect-tsgo patch 025 (tsconfigparsing.go `ValidateCompilerOptionsCallback`).
+// ValidateCompilerOptionsCallback validates the final options after configuration
+// inheritance and existing options have been merged.
+pub type ValidateCompilerOptionsCallback = std::sync::Arc<
+    dyn Fn(Option<&CompilerOptions>, Option<P<SourceFile>>) -> Vec<P<Diagnostic>> + Send + Sync,
+>;
+
+static VALIDATE_COMPILER_OPTIONS_CALLBACK: std::sync::RwLock<
+    Option<ValidateCompilerOptionsCallback>,
+> = std::sync::RwLock::new(None);
+
+// effect-tsgo patch 025 (tsconfigparsing.go `RegisterValidateCompilerOptionsCallback`).
+pub fn register_validate_compiler_options_callback(cb: ValidateCompilerOptionsCallback) {
+    *VALIDATE_COMPILER_OPTIONS_CALLBACK
+        .write()
+        .unwrap_or_else(std::sync::PoisonError::into_inner) = Some(cb);
+}
+
+/// tsrs-only (effect-tsgo patch 025): Go reads the package variable `ValidateCompilerOptionsCallback`; the Rust
+/// port clones it out of its lock so the callback runs without holding the lock.
+fn validate_compiler_options_callback() -> Option<ValidateCompilerOptionsCallback> {
+    VALIDATE_COMPILER_OPTIONS_CALLBACK
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .clone()
+}
