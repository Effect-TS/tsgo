+// effect-tsgo patch 007 (core/effect_options_test.go).
+use std::sync::Arc;
+
+use crate::CompilerOptions;
+
+#[test]
+fn test_effect_compiler_option_cloning_and_equality() {
+    let options = CompilerOptions {
+        effect: Some(Arc::new(ets_etscore::EffectPluginOptions {
+            diagnostics: true,
+            ..Default::default()
+        }))
+        .into(),
+        ..Default::default()
+    };
+    let cloned = options.clone();
+    assert!(
+        cloned.effect.get().zip(options.effect.get()).is_some_and(|(a, b)| Arc::ptr_eq(&a, &b)),
+        "shallow clone must retain Effect options"
+    );
+    assert!(options == cloned, "cloned options must be equal");
+    let equivalent = CompilerOptions {
+        effect: Some(Arc::new(ets_etscore::EffectPluginOptions {
+            diagnostics: true,
+            ..Default::default()
+        }))
+        .into(),
+        ..Default::default()
+    };
+    assert!(options == equivalent, "Effect options must compare by value");
+    let mut changed = equivalent.effect.get().unwrap();
+    Arc::make_mut(&mut changed).diagnostics = false;
+    equivalent.effect.set(Some(changed));
+    assert!(options != equivalent, "changed Effect options must invalidate equality");
+}
+
+// Rust-only: Go assigns `program.Options().Effect` through a shared options object; the cell takes that write
+// through a shared reference, and a clone taken before it keeps the old pointer (Go's shallow copy).
+#[test]
+fn test_effect_compiler_option_shared_assignment() {
+    let options = CompilerOptions::default();
+    let cloned = options.clone();
+    let shared = &options;
+    shared.effect.set(Some(Arc::new(ets_etscore::EffectPluginOptions::default())));
+    assert!(options.effect.is_some(), "assignment through a shared reference must be visible");
+    assert!(cloned.effect.is_none(), "a clone must not observe a later assignment");
+}
