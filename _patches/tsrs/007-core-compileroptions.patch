+/// effect-tsgo patch 007: the `CompilerOptions::effect` field, Go's `*etscore.EffectPluginOptions`.
+///
+/// Go assigns `program.Options().Effect` after the program is built (the `--effect-config` override of the
+/// diagnostics command), while tsrs hands out the options of a program as a shared, immutable handle; the cell lets
+/// that write go through a shared reference. Readers take a snapshot of the pointer (`get`), so a write is seen by
+/// every read that starts after it, as in Go.
+///
+/// `Clone` copies the current pointer into a new cell (Go's shallow struct copy: both share the options, and a later
+/// assignment to one does not affect the other), and `PartialEq` compares the options by value (Go's
+/// `reflect.DeepEqual` in `Equals`).
+#[derive(Default)]
+pub struct EffectOptionsCell(RwLock<Option<Arc<ets_etscore::EffectPluginOptions>>>);
+
+impl EffectOptionsCell {
+    pub fn new(effect: Option<Arc<ets_etscore::EffectPluginOptions>>) -> Self {
+        Self(RwLock::new(effect))
+    }
+
+    /// The current options (Go's read of the field).
+    pub fn get(&self) -> Option<Arc<ets_etscore::EffectPluginOptions>> {
+        self.0.read().unwrap_or_else(PoisonError::into_inner).clone()
+    }
+
+    /// Replaces the options (Go's assignment to the field).
+    pub fn set(&self, effect: Option<Arc<ets_etscore::EffectPluginOptions>>) {
+        *self.0.write().unwrap_or_else(PoisonError::into_inner) = effect;
+    }
+
+    pub fn is_some(&self) -> bool {
+        self.0.read().unwrap_or_else(PoisonError::into_inner).is_some()
+    }
+
+    pub fn is_none(&self) -> bool {
+        !self.is_some()
+    }
+}
+
+impl From<Option<Arc<ets_etscore::EffectPluginOptions>>> for EffectOptionsCell {
+    fn from(effect: Option<Arc<ets_etscore::EffectPluginOptions>>) -> Self {
+        Self::new(effect)
+    }
+}
+
+impl Clone for EffectOptionsCell {
+    fn clone(&self) -> Self {
+        Self::new(self.get())
+    }
+}
+
+impl PartialEq for EffectOptionsCell {
+    fn eq(&self, other: &Self) -> bool {
+        self.get() == other.get()
+    }
+}
+
+impl Eq for EffectOptionsCell {}
+
+impl fmt::Debug for EffectOptionsCell {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        self.get().fmt(f)
+    }
+}
