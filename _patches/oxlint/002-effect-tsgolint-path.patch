+/// The variables that make tsgolint write Go profiles (`-trace`, `-cpuprof`, `-heap`, `-allocs`).
+const TSGOLINT_PROFILING_VARIABLES: [&str; 4] = [
+    "OXLINT_TSGOLINT_TRACE",
+    "OXLINT_TSGOLINT_CPU",
+    "OXLINT_TSGOLINT_HEAP",
+    "OXLINT_TSGOLINT_ALLOCS",
+];
+
+/// Whether the linter of `EFFECT_TSGO_TSGOLINT_PATH` is tsrs, which runs it as `tsrs --lint`: the effect-tsgo proxies
+/// set `EFFECT_TSGO_TSGOLINT_MODE=tsrs` with it. The mode is ignored without `EFFECT_TSGO_TSGOLINT_PATH`, so that it
+/// never applies to a tsgolint found otherwise.
+fn effect_tsgo_tsrs_lint_mode() -> bool {
+    std::env::var_os("EFFECT_TSGO_TSGOLINT_PATH").is_some_and(|path| !path.is_empty())
+        && std::env::var("EFFECT_TSGO_TSGOLINT_MODE").is_ok_and(|mode| mode == "tsrs")
+}
+
+/// The `EFFECT_TSGO_TSGOLINT_PATH` executable when the variable is set, otherwise `try_find_tsgolint_executable`.
+/// The effect-tsgo proxies select the Effect-patched tsgolint through this variable: vite-plus sets
+/// OXLINT_TSGOLINT_PATH to the stock tsgolint for the Oxlint process it starts.
+///
+/// # Errors
+/// Returns an error if `EFFECT_TSGO_TSGOLINT_PATH` is set but is not a file, else the errors of
+/// `try_find_tsgolint_executable`.
+fn effect_tsgo_find_tsgolint_executable(cwd: &Path) -> Result<PathBuf, String> {
+    if let Some(path_str) = std::env::var("EFFECT_TSGO_TSGOLINT_PATH").ok().filter(|path| !path.is_empty()) {
+        let path = PathBuf::from(&path_str);
+        if path.is_file() {
+            return Ok(path);
+        }
+        return Err(format!(
+            "Failed to find tsgolint executable: EFFECT_TSGO_TSGOLINT_PATH points to '{path_str}' which is not a file"
+        ));
+    }
+    try_find_tsgolint_executable(cwd)
+}
