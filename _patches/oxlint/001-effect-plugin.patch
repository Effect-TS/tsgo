+fn split_tsgolint_rule_name(rule: &str) -> (Option<&str>, &str) {
+    rule.split_once('/')
+        .map_or((None, rule), |(plugin_name, rule_name)| (Some(plugin_name), rule_name))
+}
+
+fn tsgolint_rule_matches(plugin_name: &str, rule_name: &str, diagnostic_rule: &str) -> bool {
+    let (diagnostic_plugin_name, diagnostic_rule_name) = split_tsgolint_rule_name(diagnostic_rule);
+    diagnostic_rule_name == rule_name
+        && diagnostic_plugin_name.map_or(plugin_name != "effecttsgo", |name| name == plugin_name)
+}
+
+fn tsgolint_rule_severity(
+    resolved_config: &ResolvedLinterState,
+    diagnostic_rule: &str,
+) -> Option<AllowWarnDeny> {
+    resolved_config.rules.iter().find_map(|(rule, status)| {
+        (rule.is_tsgolint_rule()
+            && tsgolint_rule_matches(rule.plugin_name(), rule.name(), diagnostic_rule))
+        .then_some(*status)
+    })
+}
